# ─────────────────────────────────────────────────────────────
#  FreightLink TMS — Environment Variables
#  Copy to .env and fill in all values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3001
APP_URL=https://app.yourcompany.com
FRONTEND_URL=https://app.yourcompany.com

# ── Supabase / PostgreSQL ─────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → URI (Connection string)
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your values
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Set to 'false' only for local Postgres without SSL (e.g. Docker)
DATABASE_SSL=true

# ── JWT ──────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET

# ── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="FreightLink TMS <no-reply@yourcompany.com>"

# ── Stripe Billing ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SIGNING_SECRET
STRIPE_PRICE_STARTER=price_REPLACE_WITH_STARTER_PRICE_ID
STRIPE_PRICE_PRO=price_REPLACE_WITH_PRO_PRICE_ID

# ── Anthropic AI ─────────────────────────────────────────────
VITE_ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_ANTHROPIC_KEY

# ── Tickets (optional public submission gate) ─────────────────
PUBLIC_TICKET_KEY=

# ─────────────────────────────────────────────────────────────
# SUPABASE SETUP STEPS:
# 1. Create project at supabase.com
# 2. SQL Editor → paste contents of supabase/schema.sql → Run
# 3. Copy the connection URI from Project Settings → Database
# 4. Paste as DATABASE_URL above
# 5. npm install
# 6. npm run dev  ← auto-seeds on first start
# ─────────────────────────────────────────────────────────────
