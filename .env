# ─────────────────────────────────────────────────────────────
#  FreightLink TMS — Environment Variables
#  Copy to .env and fill in all values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3002
APP_URL=https://app.yourcompany.com

# ── JWT ──────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=6c9835bc12eece97df6d0619bb494bcd0eb7b1ab4d54ad668a7a0cf9a681dfa71d8571217e3206c8731c61694bea2c76f71ff1be6432abd7acfdca126d71b71c

# ── Email / SMTP ─────────────────────────────────────────────
# Gmail: enable 2FA → Google Account → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="FreightLink TMS <no-reply@yourcompany.com>"
# SendGrid alternative: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASS=SG.xxx

# ── Stripe Billing ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SIGNING_SECRET
STRIPE_PRICE_STARTER=price_REPLACE_WITH_STARTER_PRICE_ID
STRIPE_PRICE_PRO=price_REPLACE_WITH_PRO_PRICE_ID

# ── Anthropic AI (AI Dispatch feature) ───────────────────────
VITE_ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_ANTHROPIC_KEY

# ── Database Backup ──────────────────────────────────────────
BACKUP_DIR=./server/data/backups
BACKUP_KEEP=7
BACKUP_CRON=0 2 * * *

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=https://app.yourcompany.com
